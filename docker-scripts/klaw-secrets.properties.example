# Credentials that klaw-cluster-api needs to talk to your Kafka clusters.
#
#   cp klaw-secrets.properties.example klaw-secrets.properties     (or run ./klaw-docker.sh --init)
#
# klaw-secrets.properties is ignored by git. Never commit it.
#
# HOW THE PROPERTY NAMES WORK
# Every property below starts with a prefix: <cluster name><cluster id>, all lowercase.
# The name and id are the ones you enter when you add the cluster in the Klaw UI.
#   Cluster name "dev_cluster", id 1   ->  prefix  dev_cluster1
# In the examples below, replace "myprefix" with your own prefix.
#
# Truststore/keystore files go into ~/.klaw/truststore (outside the repository; change the
# folder with KLAW_TRUSTSTORE_DIR in .env). In the container they are at /truststore/<file name>.
#
# HOW TO CONNECT EACH CLUSTER TYPE (step by step, with screenshots):
#   https://www.klaw-project.io/docs/cluster-connectivity-setup/
#
# Uncomment and fill in only the blocks you need.

# ---------------------------------------------------------------------------
# Aiven for Apache Kafka (protocol in Klaw UI: SASL_SSL/PLAIN)
# Docs: https://www.klaw-project.io/docs/cluster-connectivity-setup/aiven-kafka-cluster-sasl-protocol
# ---------------------------------------------------------------------------
# User and password of the Kafka service user (default user: avnadmin).
#myprefix.kafkasasl.jaasconfig.plain=org.apache.kafka.common.security.plain.PlainLoginModule required username='<service-user>' password='<service-password>';
# Truststore built from the Aiven project CA certificate.
#myprefix.kafkassl.truststore.location=/truststore/client.truststore.jks
#myprefix.kafkassl.truststore.pwd=<truststore-password>
#myprefix.kafkassl.truststore.type=JKS
# Aiven API token (Aiven Console -> your profile -> Authentication -> Tokens).
# Used for ACLs and service users. Applies to all Aiven clusters.
#klaw.clusters.accesstoken=<aiven-api-token>

# ---------------------------------------------------------------------------
# Apache Kafka over SSL (protocol in Klaw UI: SSL)
# Docs: https://www.klaw-project.io/docs/cluster-connectivity-setup/kafka-cluster-ssl-protocol
# ---------------------------------------------------------------------------
#myprefix.kafkassl.keystore.location=/truststore/client.keystore.p12
#myprefix.kafkassl.keystore.pwd=<keystore-password>
#myprefix.kafkassl.key.pwd=<key-password>
#myprefix.kafkassl.keystore.type=pkcs12
#myprefix.kafkassl.truststore.location=/truststore/client.truststore.jks
#myprefix.kafkassl.truststore.pwd=<truststore-password>
#myprefix.kafkassl.truststore.type=JKS

# ---------------------------------------------------------------------------
# Apache Kafka over SASL (protocol in Klaw UI: SASL_PLAIN or SASL_SSL/<mechanism>)
# Docs: https://www.klaw-project.io/docs/cluster-connectivity-setup/kafka-cluster-sasl-protocol
# For SASL_SSL, also add the truststore lines from the blocks above.
# ---------------------------------------------------------------------------
# PLAIN:
#myprefix.kafkasasl.jaasconfig.plain=org.apache.kafka.common.security.plain.PlainLoginModule required username='<user>' password='<password>';
# SCRAM-SHA-256 / SCRAM-SHA-512:
#myprefix.kafkasasl.jaasconfig.scram=org.apache.kafka.common.security.scram.ScramLoginModule required username='<user>' password='<password>';

# ---------------------------------------------------------------------------
# Confluent Cloud
# Docs: https://www.klaw-project.io/docs/cluster-connectivity-setup/confluent-cloud-kafka-cluster-ssl-protocol
# ---------------------------------------------------------------------------
#myprefix.klaw.confluentcloud.credentials=<api-key>:<api-secret>
#myprefix.klaw.clusters.counfluentcloud.acls.api=/kafka/v3/clusters/<confluent-cluster-id>/acls
#myprefix.klaw.clusters.counfluentcloud.topics.api=/kafka/v3/clusters/<confluent-cluster-id>/topics

# ---------------------------------------------------------------------------
# Schema Registry / Karapace and Kafka Connect (credentials as user:password)
# ---------------------------------------------------------------------------
#myprefix.klaw.schemaregistry.credentials=<user>:<password>
#myprefix.klaw.kafkaconnect.credentials=<user>:<password>
# HTTPS calls to Schema Registry / Kafka Connect (protocol SSL in the UI) are made
# with the cluster-api SSL factory, which is only initialized when a key-store is set.
# NOTE: server.ssl.enabled=false is required, otherwise Spring Boot tries to serve the
# cluster-api itself over HTTPS using this truststore as a server keystore (and fails,
# because a truststore has no key entry).
#server.ssl.enabled=false
#server.ssl.key-store=/truststore/client.truststore.jks
#server.ssl.key-store-password=<truststore-password>
