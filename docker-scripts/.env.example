# Copy to .env (or run ./klaw-docker.sh --init, which creates it with random values).
# .env is ignored by git. Never commit it.

# Shared secret between klaw-core and klaw-cluster-api. Any base64 string works,
# for example: openssl rand -base64 32
KLAW_CLUSTERAPI_ACCESS_BASE64_SECRET=<base64-string>

# Password of the first superadmin user (user name: superadmin).
KLAW_SUPERADMIN_DEFAULT_PASSWORD=<choose-a-strong-password>

# Optional: folder with truststore/keystore files, mounted at /truststore in klaw-cluster-api.
# Keep it outside the repository. Default: ${HOME}/.klaw/truststore
# Example for Docker Desktop (Mac/Windows):
#KLAW_TRUSTSTORE_DIR=/Users/your-username/.klaw/truststore
